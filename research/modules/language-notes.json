  "travel_notes": [
    {
      "category": "climate",
      "title": "天气与穿着",
      "items": [
        {
          "title": "国庆昼夜温差大",
          "note": "武汉、宜昌白天约25-28°C、夜间18-21°C,恩施山区峡谷早晚更凉。建议叠穿薄外套,方便根据温差随时增减。",
          "priority": "建议"
        },
        {
          "title": "峡谷徒步易出汗",
          "note": "七星寨、梭布垭、鹿院坪台阶多、体力消耗大,容易出汗。建议穿速干透气衣物,避免纯棉衣物汗湿后难干贴身不适。",
          "priority": "建议"
        },
        {
          "title": "游船江面风大",
          "note": "两江夜游、两坝一峡游船甲板风力明显强于岸上。即使白天气温不低,也建议随身带一件可收纳的防风外套。",
          "priority": "建议"
        },
        {
          "title": "紫外线较强",
          "note": "峡谷、游船水面反光强烈,紫外线强度高于市区。建议全程做好防晒,尤其上午10点至下午3点这一强光时段。",
          "priority": "建议"
        }
      ],
      "summary": "国庆假期武汉、宜昌昼夜温差明显,恩施山区峡谷更凉,需分层穿衣并做好防晒防风准备。"
    },
    {
      "category": "etiquette",
      "title": "文化与礼仪",
      "items": [
        {
          "title": "土家表演现场礼仪",
          "note": "女儿城篝火晚会等民俗表演现场人多且互动性强。拍照录像时请留在指定观赏区域,不要越过警戒线打扰表演者。",
          "priority": "建议"
        },
        {
          "title": "景区排队秩序",
          "note": "国庆黄金周热门景点排队人数多,秩序管理压力大。请自觉排队不插队,遇到分时段限流须按预约时段有序入园。",
          "priority": "必须"
        },
        {
          "title": "土家饮食习俗",
          "note": "土家菜偏腊味腌制,口味较重且部分食材较特殊。若有忌口或饮食限制,建议提前向餐厅说明以便调整菜品。",
          "priority": "建议"
        },
        {
          "title": "自然景观保护",
          "note": "峡谷、石林等自然景观属于生态保护区域,地质结构较脆弱。请不要攀爬护栏外区域或采摘沿途植物,留意脚下安全标识。",
          "priority": "必须"
        }
      ],
      "summary": "黄金周景区客流集中,需自觉排队、尊重表演与自然保护区域规则,土家饮食习俗也需提前沟通忌口。"
    },
    {
      "category": "transport",
      "title": "当地交通",
      "items": [
        {
          "title": "恩施大峡谷↔鹿院坪无公共交通",
          "note": "两景区之间没有公交或地铁直达,完全依赖自驾或包车。必须提前联系当地包车师傅或在景区门口协商打车,车费需现场确认。",
          "priority": "必须"
        },
        {
          "title": "山区道路弯多易晕车",
          "note": "恩施、宜昌沿线多为山区盘山公路,弯道密集颠簸感明显。建议提前服用晕车药,座位尽量选择前排以减少不适。",
          "priority": "建议"
        },
        {
          "title": "国庆高峰打车较难",
          "note": "黄金周景区周边打车、网约车需求集中,等待时间明显变长。建议预留充足接驳时间,或提前通过平台预约包车。",
          "priority": "建议"
        },
        {
          "title": "跨城交通务必提前订票",
          "note": "武汉→恩施、恩施→宜昌等城际动车国庆期间需求旺盛,一票难求。建议开售当天即抢票,尤其是关键的早班车次。",
          "priority": "必须"
        }
      ],
      "summary": "恩施大峡谷与鹿院坪之间无公共交通,城际动车和景区周边打车在假期都需提前规划预留时间。"
    },
    {
      "category": "safety",
      "title": "安全与应急",
      "items": [
        {
          "title": "峡谷栈道台阶注意安全",
          "note": "七星寨绝壁栈道、鹿院坪电梯周边台阶落差大且部分路段湿滑。请扶稳护栏、不要在栈道边缘长时间停留拍照。",
          "priority": "必须"
        },
        {
          "title": "游船水上活动听从指挥",
          "note": "两江夜游、两坝一峡游船属于水上项目,存在一定安全风险。全程须按要求穿戴救生衣并听从船员指挥,不要在甲板边缘嬉闹。",
          "priority": "必须"
        },
        {
          "title": "随身携带紧急联系方式",
          "note": "恩施、宜昌山区部分路段手机信号不稳定,联系不便。建议提前将同行人手机号、住宿地址、包车师傅联系方式截图保存。",
          "priority": "建议"
        },
